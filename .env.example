# Never commit a real key. Set this value only in your local shell or .env file.
OPENROUTER_API_KEY=

# Local pre-run estimate guard. It is not a provider-side spend cap.
# Keep a separate budget/credit limit on the OpenRouter key as well.
EVAL_MAX_BATCH_COST_USD=3.00

# Local paths for approved content and results that must not be stored in this
# public repository. Ask Why regression requires all three paths below.
# EVAL_ITEMS_ROOT=/absolute/path/to/private-content/items
# EVAL_CASES_PATH=/absolute/path/to/private-content/cases/base-cases.yaml
# EVAL_RESULTS_ROOT=/absolute/path/to/private-content/results
# EVAL_ASK_WHY_RESULTS_ROOT=/absolute/path/to/private-content/ask-why-results

# Local pre-run estimate guard for the Ask Why final regression.
EVAL_ASK_WHY_REGRESSION_MAX_BATCH_COST_USD=0.50

# Optional: pin one or more OpenRouter upstream providers per model for the
# structured Ask Tutor evaluation. Without this, provider names are recorded
# but latency is a discovery measurement only.
# EVAL_PROVIDER_ORDERS_JSON={"openai/gpt-5.6-terra":["provider-name"]}

# Per-request timeout for the structured Ask Tutor runner. Some providers need
# more than 30 seconds for a valid response; retry remains limited to temporary failures.
EVAL_REQUEST_TIMEOUT_MS=60000
